NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_URL=http://localhost:3000
# Required in production: generate with node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=
# Set securely with npm run setup-owner. Publishing stays locked until configured.
OWNER_PASSWORD_HASH=
DATABASE_PATH=./data/pastes.sqlite
# Your exact HTTPS Smart Direct Link from the Adsterra publisher dashboard.
# Empty disables advertising, but keeps the 3-second bridge.
ADSTERRA_DIRECT_LINK=
# Set to 1 only behind the supplied local Nginx reverse proxy.
TRUST_PROXY=0
