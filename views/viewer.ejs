<%- include('partials/head') %>
<section class="viewer-heading"><a href="<%= isOwner ? '/owner' : '/' %>" class="back-link">← <%= isOwner ? 'My pastes' : 'Folio home' %></a><div class="eyebrow">A LITTLE SOMETHING, SHARED.</div><h1><%= paste.title || 'Untitled paste' %></h1><p>Created <time datetime="<%= new Date(paste.created_at).toISOString() %>"><%= new Date(paste.created_at).toLocaleString('en-GB', { timeZone: 'UTC', dateStyle: 'medium', timeStyle: 'short' }) %> UTC</time><span class="status-separator">·</span><%= lineCount %> <%= lineCount === 1 ? 'line' : 'lines' %><span class="status-separator">·</span><%= (byteSize / 1024).toFixed(1) %> KB</p></section>
<section class="editor-card viewer-card" aria-label="Paste content"><div class="card-toolbar"><div class="toolbar-title"><span class="document-icon" aria-hidden="true">≡</span> <span class="pill">PLAIN TEXT</span></div><div class="viewer-actions"><button type="button" class="small-button" id="wrap-button" aria-pressed="false">Wrap lines</button><a class="small-button" href="/p/<%= paste.id %>/raw">Raw</a><a class="small-button" href="/p/<%= paste.id %>/download">Download <span aria-hidden="true">↓</span></a><button type="button" class="small-button copy-content" data-copy="paste-content">Copy text</button></div></div><pre id="paste-content" tabindex="0"><%= paste.content %></pre><div class="editor-status"><span><span class="status-dot"></span> End of paste</span><span>UTF-8</span></div></section>
<div class="viewer-bottom"><div class="viewer-share"><input id="share-url" readonly value="<%= shareUrl %>" aria-label="Shareable paste URL"><button class="button secondary" type="button" data-copy="share-url">Copy link <span aria-hidden="true">↗</span></button></div><p class="viewer-expiry"><%- include('partials/expiry', { paste }) %></p></div>
<% if (nativeAd) { %><section class="native-ad" aria-label="Sponsored content"><div class="native-ad-label">Sponsored</div><div class="native-ad-slot"><script async="async" data-cfasync="false" src="<%= nativeAd.scriptUrl %>"></script><div id="<%= nativeAd.containerId %>"></div></div></section><% } %>
<%- include('partials/footer') %>
