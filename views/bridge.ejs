<%- include('partials/head') %>
<section class="center-stage">
  <div class="flow-steps" aria-label="Step 2 of 3"><span>01 <b>Shared</b></span><i></i><span class="current">02 <b>Continue</b></span><i></i><span>03 <b>Read</b></span></div>
  <div class="flow-card" id="gateway" data-wait="<%= waitMs %>" data-sponsor="<%= adUrl %>">
    <div class="gateway-icon" aria-hidden="true">↓</div>
    <span class="pill accent">ONE SMALL STEP</span>
    <h1>Your paste is ready.</h1><p>Take a moment. Your text is just ahead.</p>
    <div class="paste-summary"><span class="document-icon" aria-hidden="true">≡</span><div><strong><%= paste.title || 'Untitled paste' %></strong></div><span class="ready-dot" aria-hidden="true"></span></div>
    <div class="gateway-note"><p><% if (adUrl) { %>A little support keeps Folio running.<br><strong>Continuing opens a sponsor in a new tab. Pop-ups must be allowed.</strong><% } else { %>Good things take a moment.<br><strong>Your paste will be ready in three seconds.</strong><% } %></p></div>
    <p class="bridge-expiry"><%- include('partials/expiry', { paste }) %></p>
    <form method="post" action="/p/<%= paste.id %>/unlock" id="unlock-form">
      <input type="hidden" name="token" value="<%= token %>">
      <button type="submit" class="button primary full" id="proceed-button" disabled>Proceed to paste</button>
    </form>
    <% if (adUrl) { %><p class="gateway-error" id="sponsor-error" role="alert" hidden>Your browser blocked the sponsor tab. Allow pop-ups for this site and try again.</p><% } %>
    <noscript><p class="fine-print">JavaScript and cookies are required to continue.<% if (adUrl) { %> Enable JavaScript and allow pop-ups for this site.<% } %></p></noscript>
    <p class="fine-print">No downloads or sign-ups are required to read a paste.<% if (adUrl) { %><br>You can close the sponsor tab at any time.<% } %></p>
  </div>
</section>
<%- include('partials/footer') %>
