<%- include('partials/head') %>
<section class="center-stage">
  <div class="flow-steps" aria-label="Step 2 of 3"><span>01 <b>Shared</b></span><i></i><span class="current">02 <b>Continue</b></span><i></i><span>03 <b>Read</b></span></div>
  <div class="flow-card" id="gateway" data-wait="<%= waitMs %>" data-sponsor="<%= adUrl %>">
    <div class="gateway-icon" aria-hidden="true">↗</div>
    <span class="pill accent">ONE SMALL STEP</span>
    <h1>Your paste is ready.</h1><p>Take a moment. Your text is just ahead.</p>
    <div class="paste-summary"><span class="document-icon" aria-hidden="true">≡</span><div><strong><%= paste.title || 'Untitled paste' %></strong><span>Plain text · Ready to read</span></div><span class="ready-dot" aria-hidden="true"></span></div>
    <div class="gateway-note"><span aria-hidden="true">✳</span><p><% if (adUrl) { %>A little support keeps Folio running.<br><strong>Continuing opens a sponsor in a new tab.</strong><% } else { %>Good things take a moment.<br><strong>Your paste will be ready in three seconds.</strong><% } %></p></div>
    <form method="post" action="/p/<%= paste.id %>/unlock" id="unlock-form">
      <input type="hidden" name="token" value="<%= token %>">
      <button type="submit" class="button primary full" id="proceed-button">Proceed to paste <span aria-hidden="true">↗</span></button>
      <p class="countdown-message" id="countdown-message" role="status">Please wait 3 seconds before continuing.</p>
      <% if (adUrl) { %><button class="quiet-link fallback" type="submit" id="fallback-button" name="fallback" value="1">Sponsor blocked? Continue without it</button><% } %>
    </form>
    <noscript><p class="fine-print">Wait three seconds, then press Proceed to paste. Cookies are required.<% if (adUrl) { %> <a href="<%= adUrl %>" target="_blank" rel="noopener noreferrer sponsored">Visit our sponsor</a> to support Folio.<% } %></p></noscript>
    <p class="fine-print">No downloads or sign-ups are required to read a paste.<% if (adUrl) { %><br>You can close the sponsor tab at any time.<% } %></p>
  </div>
</section>
<%- include('partials/footer') %>
