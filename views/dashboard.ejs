<%- include('partials/head') %>
<section class="workspace-heading"><div><div class="eyebrow"><span class="status-dot"></span> YOUR PRIVATE WORKSPACE</div><h1>Your words. <span>All in one place.</span></h1><p><%= total %> <%= total === 1 ? 'paste' : 'pastes' %> in your library.</p></div><a class="button primary" href="/owner/new">Create paste <span aria-hidden="true">＋</span></a></section>
<section class="editor-card dashboard-card"><div class="card-toolbar"><div class="toolbar-title">All pastes <span class="pill">OWNER ONLY</span></div><span class="toolbar-note">Newest first</span></div>
<% if (!pastes.length) { %><div class="empty-library"><span class="gateway-icon" aria-hidden="true">≡</span><h2>Your next idea starts here.</h2><p>Create your first paste and give it a link.</p><a class="button secondary" href="/owner/new">Create a paste</a></div><% } %>
<% pastes.forEach(paste => { %><article class="paste-row"><span class="document-icon" aria-hidden="true">≡</span><div class="paste-row-info"><a class="paste-row-title" href="/p/<%= paste.id %>/view"><%= paste.title || 'Untitled paste' %></a><p><time datetime="<%= new Date(paste.created_at).toISOString() %>"><%= new Date(paste.created_at).toLocaleString('en-GB', { timeZone: 'UTC', dateStyle: 'medium', timeStyle: 'short' }) %> UTC</time></p><p><span class="view-count"><%= paste.view_count %> <%= paste.view_count === 1 ? 'view' : 'views' %></span><span class="status-separator">·</span><%- include('partials/expiry', { paste }) %></p><input class="sr-only" id="link-<%= paste.id %>" readonly value="<%= origin %>/p/<%= paste.id %>" aria-label="Share link for <%= paste.title || 'Untitled paste' %>"></div><div class="row-actions"><button class="small-button" type="button" data-copy="link-<%= paste.id %>">Copy link</button><a class="small-button" href="/p/<%= paste.id %>/view">Open ↗</a><a class="small-button danger-link" href="/owner/pastes/<%= paste.id %>/delete">Delete</a></div></article><% }) %>
</section>
<div class="pagination"><% if (pageNumber > 1) { %><a class="button secondary" href="/owner?page=<%= pageNumber - 1 %>">← Previous</a><% } %><span>Page <%= pageNumber %> of <%= pages %></span><% if (pageNumber < pages) { %><a class="button secondary" href="/owner?page=<%= pageNumber + 1 %>">Next →</a><% } %></div>
<%- include('partials/footer') %>
