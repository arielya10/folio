{
  "name": "folio-paste",
  "version": "1.0.0",
  "private": true,
  "description": "A lightweight, self-hosted pastebin with a transparent sponsor gateway",
  "type": "module",
  "engines": { "node": ">=24.13.0 <25" },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --watch --env-file-if-exists=.env server.js",
    "test": "node --test",
    "backup": "node --env-file-if-exists=.env scripts/backup.js",
    "delete-paste": "node --env-file-if-exists=.env scripts/delete-paste.js"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0"
  },
  "devDependencies": { "supertest": "^7.1.4" }
}
